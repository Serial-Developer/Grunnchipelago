# Archipelago checkout (vendored dependency, not versioned here)
Archipelago/

# Build artifacts
dist/
apworld/**/__pycache__/

# Python
__pycache__/
*.pyc
.venv*/
venv*/

# C# / .NET (Grunnchipelago.Dumper)
bin/
obj/
*.user

# Game binaries / decompiled assemblies (never commit game DLLs)
*.dll
*.exe
*.pdb

# BepInEx download artifact
BepInEx_win_*/
BepInEx_win_*.zip

# Editor / OS
.vs/
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# Local spoilers / seeds
*_Spoiler.txt
*.archipelago

# Working notes: prompts, playtest journals, personal test profiles. They stay on the
# author's machine - useful history, but not part of what the project ships.
design/prompt_cc_*.md
design/playtest_notes.md
design/backlog_checks.md
players/multiworld_test/

# Generated by Archipelago from options.py - never hand-edited, never committed:
# players download it from the website, or run the Archipelago Launcher to regenerate it.
players/Grunn_template.yaml

# Sorties regenerables du generateur de regions (la reference est design/regions.md)
design/regions_auto.*
